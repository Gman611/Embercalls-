# =============================================
# EmberCalls - Environment Variables
# =============================================

# Server Port
PORT=3000

# JWT Secret (Change this to a long random string!)
JWT_SECRET=super_secret_jwt_key_embercalls_2026_change_this_to_something_very_long_and_random_like_64_characters_or_more

# Database Connection (Replace with your real Neon/Supabase/Railway URL)
DATABASE_URL=postgresql://username:password@your-database-host:5432/embercalls

# Optional: TURN Server (for better video calls through firewalls)
# Get free TURN from: https://www.metered.ca/tools/turn or Twilio
TURN_URL=turn:global.turn.twilio.com:3478
TURN_USERNAME=your_twilio_turn_username
TURN_PASSWORD=your_twilio_turn_password

# =============================================
# Production Notes:
# - Never commit this file with real secrets
# - Generate a strong JWT_SECRET (use random.org or password generator)
# =============================================
